<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleDisplayName</key><string>FinTrack</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key><string>FinTrack Shortcut Draft</string>
            <key>CFBundleURLSchemes</key><array><string>fintrack</string></array>
        </dict>
    </array>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>NSFaceIDUsageDescription</key><string>Unlock your private finance data.</string>
    <key>NSCameraUsageDescription</key><string>Scan receipts and bills on your device.</string>
    <key>NSLocationWhenInUseUsageDescription</key><string>Use your location to mark where this transaction happened.</string>
    <key>NSMicrophoneUsageDescription</key><string>Use your voice to prepare a transaction draft.</string>
    <key>NSSpeechRecognitionUsageDescription</key><string>Transcribe your spoken transaction on this device.</string>
    <key>UIBackgroundModes</key>
    <array><string>remote-notification</string></array>
    <key>RemoteNotificationsAvailable</key><true/>
    <key>WidgetKeychainAccessGroup</key>
    <string>$(AppIdentifierPrefix)app.fintrack.widgetdata</string>
    <key>UILaunchStoryboardName</key><string>LaunchScreen</string>
    <key>UIRequiredDeviceCapabilities</key><array><string>arm64</string></array>
    <key>UISupportedInterfaceOrientations</key>
    <array><string>UIInterfaceOrientationPortrait</string></array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict>
</plist>
